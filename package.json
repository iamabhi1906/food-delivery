{
	"name": "food-delivery",
	"version": "0.0.1",
	"description": "Production-ready NestJS Modular Monolith for Food Delivery with PostgreSQL and TypeORM",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"format": "biome format --write src",
		"format:check": "biome format src",
		"lint": "biome lint --write src",
		"lint:check": "biome lint src",
		"check": "biome check --write src",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"typeorm:ts": "tsx ./node_modules/typeorm/cli.js",
		"typeorm:js": "node ./node_modules/typeorm/cli.js",
		"migration:create": "typeorm-ts-node-commonjs migration:create",
		"migration:generate": "typeorm-ts-node-commonjs migration:generate dist/database/migrations/Init -d dist/data-source.js",
		"migration:run": "typeorm-ts-node-commonjs migration:run -d dist/data-source.js",
		"migration:revert": "typeorm-ts-node-commonjs migration:revert -d dist/data-source.js",
		"migration:run:all": "pnpm migration:users:run && pnpm migration:orders:run && pnpm migration:notifications:run",
		"migration:run:all:prod": "pnpm migration:users:run:prod && pnpm migration:orders:run:prod && pnpm migration:notifications:run:prod"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/typeorm": "^12.0.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.4",
		"dotenv": "^17.4.2",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"typeorm": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"source-map-support": "^0.5.21",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	}
}
